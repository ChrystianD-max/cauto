# =============================================================================
# C-AUTO — MODÈLE D'ENVIRONNEMENT LOCAL (module 51)
# -----------------------------------------------------------------------------
# Copier ce fichier vers .env puis remplir les valeurs AVANT de démarrer :
#   cp .env.example .env
#
# RÈGLE ABSOLUE : AUCUNE vraie clé n'est écrite dans le code ni dans ce modèle.
# Toutes les valeurs ci-dessous sont vides (ou des défauts non confidentiels).
# .env (qui, lui, contient vos vraies clés) est exclu du contrôle de version
# (.gitignore). Les clés ne sont lues qu'à l'exécution via process.env
# (src/config.js) — jamais exposées par l'API, jamais commitées.
#
#   - node sans Docker : .env est chargé automatiquement (dotenv, voir config.js)
#   - docker compose  : les variables sont injectées par le service backend
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=staging            # staging | production
APP_URL=http://localhost:4000
SERVER_NAME=localhost
# URL publique réelle (derrière le proxy TLS). Vide => APP_URL est utilisée.
APP_PUBLIC_URL=
# Approuver les en-têtes X-Forwarded-* (proxy TLS / Caddy / plateforme hébergeur).
TRUST_PROXY=1
# Module 61 — Domaines : origines CORS complémentaires (CSV), pour déclarer les
# autres sous-domaines quand l'API n'est pas servie par la même origine que le
# frontend, ex :
# CORS_ORIGINS=https://app.cauto.example,https://www.cauto.example,https://admin.cauto.example
CORS_ORIGINS=

# Module 62 — HTTPS : cookie de session (refresh token) httpOnly.
#   Secure:true est automatique en NODE_ENV=production (HTTPS uniquement).
#   COOKIE_SECURE=true force le flag même hors production (proxy TLS local).
#   COOKIE_SAME_SITE=lax (défaut) — strict possible sur hôte unique.
#   COOKIE_DOMAIN=.cauto.example : domaine parent (partage api./app./admin.), vide = cookie host-only.
#   REFRESH_COOKIE_NAME / REFRESH_COOKIE_MAX_AGE_MS : nom & durée du cookie (défaut 30 j).
# COOKIE_SECURE=
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# REFRESH_COOKIE_NAME=cauto_refresh
# REFRESH_COOKIE_MAX_AGE_MS=2592000000

# -----------------------------------------------------------------------------
# 2. BASE DE DONNÉES & CACHE
# -----------------------------------------------------------------------------
DATABASE_URL=
# ex. postgresql://cauto:cauto@localhost:5432/cauto
REDIS_URL=
# ex. redis://localhost:6379
JWT_SECRET=
# OBLIGATOIRE — ex : openssl rand -hex 32
JWT_EXPIRES_IN=2h
PORT=4000
# Dossier de stockage des documents (moteur local actuel, voir §4)
UPLOAD_DIR=/data/uploads

# -----------------------------------------------------------------------------
# 3. MODE DÉMONSTRATION (module 50)
# -----------------------------------------------------------------------------
DEMO_MODE=false
# true  => paiement réel, SMS, WhatsApp, GPS temps réel et IA externe simulés ;
#          l'interface affiche le bandeau "MODE DÉMONSTRATION".

# -----------------------------------------------------------------------------
# 3bis. COMPTE ADMIN DE DÉVELOPPEMENT (module 80) — seed uniquement, jamais en prod
#    Créé par backend/seed/seed.js (npm run db:seed) UNIQUEMENT hors production,
#    à partir des variables ci-dessous. Aucun mot de passe réel n'est jamais
#    commité ; SEED_ADMIN_PASSWORD vide ou CHANGE_ME => rien n'est créé.
# -----------------------------------------------------------------------------
# SEED_ADMIN_EMAIL=admin.dev@cauto.local
# SEED_ADMIN_NAME=Admin Développement
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=

# -----------------------------------------------------------------------------
# 3ter. LIMITE DE DÉBIT (anti-abus)
#    Défauts production : 300 requêtes /api / 15 min, 20 tentatives d'auth /
#    15 min, 10 codes OTP / 15 min.
#    À relever en développement pour exécuter les suites de tests automatisées.
# -----------------------------------------------------------------------------
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_OTP_MAX=10

# -----------------------------------------------------------------------------
# 4. STOCKAGE OBJET (S3-compatible) — passerelle implémentée (modules 59/60)
#    Stockage fournisseur-agnostique : AWS S3, Cloudflare R2, Supabase Storage
#    (passerelle S3), MinIO, Backblaze B2, Ceph, Garantia…
#    STORAGE_MODE :
#      auto  (défaut) => S3 SI endpoint + access_key + secret_key + bucket
#                        renseignés, sinon stockage disque local (UPLOAD_DIR) ;
#      s3    => exige le stockage objet (échec au démarrage si non configuré) ;
#      local => force le disque local.
#    En mode S3, le fichier local est supprimé après publication sauf si
#    STORAGE_KEEP_LOCAL=true (ex. volume pour scans antivirus). Les objets sont
#    servis via l'API (reste same-origin) ou directement depuis STORAGE_PUBLIC_URL
#    si celle-ci est fournie (CDN / domaine du bucket).
# -----------------------------------------------------------------------------
STORAGE_MODE=auto
STORAGE_ENDPOINT=
# ex. https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (R2)
# ex. https://<PROJECT>.supabase.co/storage/v1/s3   (Supabase)
# ex. https://s3.<région>.amazonaws.com             (AWS S3)
STORAGE_REGION=auto
# Amazon S3 : région réelle (ex. eu-west-3) ; R2/MinIO : "auto" (défaut).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Préfixe des clés d'objet (multi-apps sur un même bucket).
STORAGE_PREFIX=cauto
# true pour les buckets "path style" (/bucket/key) : R2, MinIO, Supabase, B2.
STORAGE_FORCE_PATH_STYLE=false
STORAGE_KEEP_LOCAL=false
# URL publique optionnelle pour servir les objets directement (CDN) — vide = API.
STORAGE_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 5. PAIEMENT
#    PAYMENT_PROVIDER documente la passerelle cible ; le code choisit un
#    fournisseur par méthode (MTN_MOMO / MOOV_MONEY / WAVE / CARD / CASH /
#    CAUTO_WALLET) et s'appuie sur PAYMENT_MODE pour sandbox/live.
#    PAYMENT_MODE=sandbox + MODE DÉMONSTRATION => aucun débit réel possible.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_MODE=sandbox       # sandbox | live
PAYMENT_WEBHOOK_SECRET=
# Clés par passerelle (UEMOA) :
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_URL=
WAVE_API_KEY=
WAVE_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=
CARD_API_KEY=
CARD_API_URL=
CARD_PROVIDER=

# -----------------------------------------------------------------------------
# 6. CARTE / ROUTING GPS
#    MAP_PROVIDER documente le fournisseur cartographique ; le serveur utilise
#    ROUTING_* pour calculer distance/durée (routeur externe OSRM/GraphHopper)
#    ou le mode haversine par défaut (simulé en MODE DÉMONSTRATION).
# -----------------------------------------------------------------------------
MAP_PROVIDER=
MAP_API_KEY=
ROUTING_PROVIDER=haversine # haversine | external
ROUTING_API_URL=
ROUTING_API_KEY=
DEFAULT_COUNTRY=BJ
DEFAULT_LOCALE=fr

# -----------------------------------------------------------------------------
# 7. SMS
#    SMS_PROVIDER documente le prestataire SMS ; les clés réelles ci-dessous.
#    En MODE DÉMONSTRATION aucun SMS réel n'est émis (canal CHAT C-AUTO).
# -----------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=CAUTO
# OTP : si OTP_API_URL + OTP_API_KEY renseignés, le code est envoyé par SMS ;
# sinon (ou en démo) il est retourné à l'API pour tests (medium demo/debug).
OTP_API_URL=
OTP_API_KEY=

# -----------------------------------------------------------------------------
# 8. E-MAIL
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=

# -----------------------------------------------------------------------------
# 9. WHATSAPP
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE=cauto_plain

# -----------------------------------------------------------------------------
# 10. PUSH / NOTIFICATIONS
# -----------------------------------------------------------------------------
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT=
NOTIF_FALLBACK_ORDER=push,sms,email,whatsapp

# -----------------------------------------------------------------------------
# 11. IA EXTERNE (prévue)
#    Aucune IA externe n'est encore intégrée : le diagnostic s'appuie sur un
#    moteur local (src/utils/diagnosticService.js), signalé "local" dans
#    /api/config. AI_PROVIDER / AI_API_KEY sont réservés à l'intégration future.
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=

# -----------------------------------------------------------------------------
# 12. SÉCURITÉ DOCUMENTS (optionnel)
# -----------------------------------------------------------------------------
AV_SCAN_CMD=
# Taille max. upload (octets), défaut 5 Mo :
DOC_MAX_BYTES=5242880

# -----------------------------------------------------------------------------
# 13. SAUVEGARDES (module 64) - deploy/backup.sh + deploy/restore-test.sh
#    Une sauvegarde n'est réussie que si elle est validée (archive lisible,
#    tables critiques présentes, sha256) ET restaurée avec succès via
#    ./deploy/restore-test.sh. Les fichiers seuls ne comptent pas.
# -----------------------------------------------------------------------------
# Dossier local des sauvegardes (écrit par le script) :
BACKUP_DIR=./backups
# Conservation historique (rotation quotidienne/hebdomadaire/mensuelle) :
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=6
# Stockage EXTERNE : réutilise la section 4 (STORAGE_*) — le dump est poussé
# vers le bucket sous <STORAGE_PREFIX>/backups/ puis VÉRIFIÉ (taille + sha256).
# BACKUP_REMOTE_KEEP conserve les N objets distants les plus récents (déf. 30).
BACKUP_REMOTE_KEEP=30
# Webhook optionnel pingué à chaque exécution (succès / échec) :
BACKUP_NOTIFY_URL=

# -----------------------------------------------------------------------------
# 14. OBSERVABILITÉ (module 65) - logs structurés, métriques, disponibilité
#    Architecture extensible : serveur = src/observability/ (logger JSON sur
#    stdout, registre Prometheus protégé, hooks telemetry.js pour brancher plus
#    tard Sentry / OpenTelemetry / Grafana sans toucher au serveur).
# -----------------------------------------------------------------------------
# Niveau des logs JSON écrits sur stdout (debug|info|warn|error|fatal) :
LOG_LEVEL=info
# Export Prometheus actif (true) : endpoint /api/ops/metrics
METRICS_ENABLED=true
# Token Bearer protégeant l'export Prometheus. EN PRODUCTION il est OBLIGATOIRE
# : sans token configuré, /api/ops/metrics est REFUSÉ (404) — jamais exposé nu.
# Générer : openssl rand -hex 32
METRICS_TOKEN=
# Préfixe de namespace des noms de métriques (défaut cauto) :
METRICS_PREFIX=cauto
# Nom du service (voir /api/ops/info et les métriques) :
SERVICE_NAME=cauto-backend
# Watchdog disponibilité : sonde périodique réelle (db + redis). Après N sondes
# dégradées consécutives (ALERT_UNHEALTHY_THRESHOLD), le webhook est notifié
# avec l'événement ; le retour en santé déclenche un événement de récupération.
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_CHECK_INTERVAL_MS=30000
ALERT_UNHEALTHY_THRESHOLD=3