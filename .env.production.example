# =============================================================================
# C-AUTO — MODÈLE D'ENVIRONNEMENT DE PRODUCTION (module 79)
# -----------------------------------------------------------------------------
# Copier vers .env sur le serveur : cp .env.production.example .env
# AUCUNE vraie clé n'est écrite dans le code ni dans ce modèle : tout vient de
# l'environnement. .env est exclu du contrôle de version (.gitignore).
# La version étendue et commentée se trouve dans deploy/.env.production.example.
# =============================================================================

# ----- 1. APPLICATION -----
APP_ENV=production
NODE_ENV=production
# URL publique réelle derrière le proxy TLS :
APP_URL=https://cauto.example
APP_PUBLIC_URL=https://cauto.example
SERVER_NAME=cauto.example
TRUST_PROXY=1
# Origines CORS complémentaires (CSV) :
CORS_ORIGINS=https://www.cauto.example,https://app.cauto.example,https://admin.cauto.example

# ----- 2. BASE DE DONNÉES & CACHE (managés recommandés) -----
# PostgreSQL managé (sslmode=require recommandé) :
DATABASE_URL=postgresql://cauto:CHANGE_ME@HOST:5432/cauto?sslmode=require
# Redis managé (rediss:// = TLS) :
REDIS_URL=rediss://default:CHANGE_ME@HOST:6379
# OBLIGATOIRE — générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=2h
# Stockage local (uniquement si aucun S3 n'est configuré) :
UPLOAD_DIR=/data/uploads

# ----- 3. MODE DÉMONSTRATION (toujours false en production) -----
DEMO_MODE=false

# ----- 4. HTTPS — domaines (module 61) + cookies sécurisés (module 62) ------
# Caddy (deploy/) délivre un certificat Let's Encrypt pour CHAQUE hôte.
# Caddy redirige en permanence HTTP → HTTPS et envoie Strict-Transport-Security
# (HSTS) ; les cookies backend sont Secure en production.
CADDY_DOMAIN=cauto.example
CADDY_WWW_DOMAIN=www.cauto.example
CADDY_APP_DOMAIN=app.cauto.example
CADDY_API_DOMAIN=api.cauto.example
CADDY_ADMIN_DOMAIN=admin.cauto.example
# E-mail pour les notifications Let's Encrypt :
# CADDY_EMAIL=admin@example.com
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.cauto.example
# REFRESH_COOKIE_MAX_AGE_MS=2592000000

# ----- 5. STOCKAGE OBJET S3-compatible -----
STORAGE_MODE=s3
STORAGE_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com    # ex. R2
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=cauto-prod
STORAGE_PREFIX=cauto
# R2 / MinIO / Supabase / B2 : true. AWS S3 usuel : false.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_KEEP_LOCAL=false
STORAGE_PUBLIC_URL=

# ----- 6. LIMITES DE DÉBIT (défauts production) -----
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OTP_MAX=10

# ----- 7. PAIEMENT (sandbox en premier déploiement) -----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_URL=
WAVE_API_KEY=
WAVE_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=
CARD_API_KEY=
CARD_API_URL=
CARD_PROVIDER=

# ----- 8. CARTE / ROUTING GPS -----
MAP_PROVIDER=
MAP_API_KEY=
ROUTING_PROVIDER=haversine
ROUTING_API_URL=
ROUTING_API_KEY=
DEFAULT_COUNTRY=BJ
DEFAULT_LOCALE=fr

# ----- 9. SMS / OTP -----
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=CAUTO
OTP_API_URL=
OTP_API_KEY=

# ----- 10. E-MAIL -----
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=

# ----- 11. WHATSAPP -----
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE=cauto_plain

# ----- 12. PUSH / NOTIFICATIONS -----
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT=
NOTIF_FALLBACK_ORDER=push,sms,email,whatsapp

# ----- 13. IA EXTERNE (réservée à une future intégration) -----
AI_PROVIDER=
AI_API_KEY=

# ----- 14. SÉCURITÉ FICHIERS -----
# Scan antivirus optionnel (ex: clamscan). Vide = désactivé.
AV_SCAN_CMD=
DOC_MAX_BYTES=5242880

# ----- 15. SAUVEGARDES (module 64) -----
# deploy/backup.sh (dump + validation + rotation + stockage externe) et
# deploy/restore-test.sh (restauration testée). Une sauvegarde sans restauration
# réussie n'est PAS une sauvegarde.
BACKUP_DIR=/srv/cauto/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=6
# Réutilise les identifiants STORAGE_* : dump poussé sous <prefix>/backups/.
BACKUP_REMOTE_KEEP=30
BACKUP_NOTIFY_URL=

# ----- 16. OBSERVABILITÉ (module 65) -----
LOG_LEVEL=info
METRICS_ENABLED=true
# EN PRODUCTION le token est OBLIGATOIRE : sans METRICS_TOKEN, /api/ops/metrics
# est refusé (404) — jamais exposé nu. Générer : openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_32
METRICS_PREFIX=cauto
SERVICE_NAME=cauto-backend
# Watchdog : webhook notifié après ALERT_UNHEALTHY_THRESHOLD sondes dégradées
# consécutives puis à la récupération :
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_CHECK_INTERVAL_MS=30000
ALERT_UNHEALTHY_THRESHOLD=3