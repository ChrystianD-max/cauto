# =============================================================================
# C-AUTO — MODÈLE D'ENVIRONNEMENT DE DÉVELOPPEMENT (module 79)
# -----------------------------------------------------------------------------
# Copier vers .env avant de développer :
#   cp .env.development.example .env
#   Windows (PowerShell) : Copy-Item .env.development.example .env
#
# RÈGLE ABSOLUE : AUCUNE vraie clé n'est écrite dans le code ni dans ce modèle.
# .env (qui contient vos valeurs locales) est exclu du contrôle de version
# (.gitignore). Docker Compose (docker-compose.yml) surcharge/prime ces valeurs
# pour les variables qu'il définit lui-même (DATABASE_URL inter-conteneurs).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:4000
SERVER_NAME=localhost
TRUST_PROXY=1
# Origines CORS complémentaires (CSV) :
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 2. BASE DE DONNÉES & CACHE (Postgres/Redis locaux, non conteneurisés)
#    Avec Docker Compose, ces valeurs sont SURRÉCRITES par docker-compose.yml :
#      DATABASE_URL=postgresql://cauto:cauto@postgres:5432/cauto
#      REDIS_URL=redis://redis:6379
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://cauto:cauto@localhost:5432/cauto
REDIS_URL=redis://localhost:6379
# OBLIGATOIRE — générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=2h
PORT=4000
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# 3. MODE DÉMONSTRATION (module 50)
#    true => paiement réel, SMS, WhatsApp, GPS temps réel et IA externe simulés.
# -----------------------------------------------------------------------------
DEMO_MODE=true

# -----------------------------------------------------------------------------
# 3bis. LIMITE DE DÉBIT (relevées en développement pour les suites de tests)
# -----------------------------------------------------------------------------
RATE_LIMIT_API_MAX=2000
RATE_LIMIT_AUTH_MAX=500
RATE_LIMIT_OTP_MAX=300

# -----------------------------------------------------------------------------
# 4. STOCKAGE OBJET (S3-compatible) — vide = disque local (UPLOAD_DIR)
# -----------------------------------------------------------------------------
STORAGE_MODE=auto
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PREFIX=cauto
STORAGE_FORCE_PATH_STYLE=false
STORAGE_KEEP_LOCAL=false
STORAGE_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 5. COMPTE ADMIN DE DÉVELOPPEMENT (module 80) — seed seulement, jamais en prod
#    SEED_ADMIN_PASSWORD vide ou CHANGE_ME => rien n'est créé.
#    Aucun mot de passe réel n'est jamais commité.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin.dev@cauto.local
SEED_ADMIN_NAME=Admin Développement
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# -----------------------------------------------------------------------------
# 6. PAIEMENT — rester en sandbox/aucun débit en développement
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 7. DIVERS — défauts raisonnables en développement
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
METRICS_ENABLED=true
# JWT / sécurité documentaire :
DOC_MAX_BYTES=5242880
DEFAULT_COUNTRY=BJ
DEFAULT_LOCALE=fr