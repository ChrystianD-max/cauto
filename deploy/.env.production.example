# =============================================================================
# C-AUTO — MODÈLE D'ENVIRONNEMENT PRODUCTION  (modules 59/60)
# -----------------------------------------------------------------------------
# Copier vers .env puis remplir AVANT de déployer. AUCUNE vraie clé n'est
# écrite dans le code ni dans ce modèle : tout vient de l'environnement.
#
# Principes de portabilité (aucun hébergeur imposé) :
#   - DATABASE_URL  : base PostgreSQL managée (Neon, Supabase, RDS, Aiven…)
#                     OU le postgres du compose (hotspot du dépôt) ;
#   - REDIS_URL     : Redis managé (Upstash, Render Redis, ElastiCache…) OU
#                     le redis du compose ;
#   - STORAGE_*     : tout stockage objet S3-compatible (R2, Supabase, MinIO,
#                     AWS S3, Backblaze B2) — sinon UPLOAD_DIR local.
#   - TLS           : HTTPS confié à Caddy (deploy/) ou à la plateforme.
# =============================================================================

# ----- 1. APPLICATION -----
APP_ENV=production
# Le domaine réel sera configuré ultérieurement (module 61). Exemples ci-dessous
# avec cauto.example : remplacez par c-auto.com / c-auto.xxx une fois connus.
APP_URL=https://cauto.example
APP_PUBLIC_URL=https://cauto.example
TRUST_PROXY=1
# Origines CORS (format CSV) : les autres hôtes appelants l'API depuis un
# navigateur — app., admin., www. — quand ils ne servent pas l'API eux-mêmes.
CORS_ORIGINS=https://www.cauto.example,https://app.cauto.example,https://admin.cauto.example

# ----- 2. BASE DE DONNÉES & CACHE (managés recommandés) -----
# PostgreSQL managé (sslmode=require recommandé) :
DATABASE_URL=postgresql://cauto:CHANGE_ME@HOST:5432/cauto?sslmode=require
# Redis managé (rediss:// = TLS) ou redis://redis:6379 en local :
REDIS_URL=rediss://default:CHANGE_ME@HOST:6379
# OBLIGATOIRE — générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=2h
# Stockage local (seulement si aucun S3 n'est configuré) :
UPLOAD_DIR=/data/uploads

# ----- 3. MODE DÉMONSTRATION (toujours false en production) -----
DEMO_MODE=false

# ----- 4. STOCKAGE OBJET S3-compatible -----
STORAGE_MODE=s3
STORAGE_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com    # ex. R2
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=cauto-prod
STORAGE_PREFIX=cauto
# R2 / MinIO / Supabase / B2 : true. AWS S3 usuel : false.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_KEEP_LOCAL=false
# CDN optionnel pour servir les objets directement (vide = via l'API) :
STORAGE_PUBLIC_URL=

# ----- 5. HTTPS — domaines (module 61) + cookies sécurisés (module 62) -------
# Le domaine réel sera configuré ultérieurement. Caddy (deploy/) délivre un
# certificat Let's Encrypt pour CHAQUE hôte ci-dessous. Les hôtes dérivés
# (www / app / api / admin) prennent leur valeur par défaut depuis CADDY_DOMAIN
# si l'un d'eux n'est pas renseigné.
# Caddy redirige en permanence HTTP → HTTPS (explicite dans deploy/Caddyfile)
# et envoie Strict-Transport-Security (HSTS) — les cookies du backend sont
# Secure en production (module 62).
CADDY_DOMAIN=cauto.example
CADDY_WWW_DOMAIN=www.cauto.example
CADDY_APP_DOMAIN=app.cauto.example
CADDY_API_DOMAIN=api.cauto.example
CADDY_ADMIN_DOMAIN=admin.cauto.example
# E-mail pour les notifications Let's Encrypt (renouvellement) :
# CADDY_EMAIL=admin@example.com
# Cookie de session (refresh token) httpOnly. Secure:true est automatique en
# production. COOKIE_DOMAIN : domaine parent pour partager entre sous-domaines
# api./app./admin. — vide = cookie host-only (api. uniquement).
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.cauto.example
# REFRESH_COOKIE_MAX_AGE_MS=2592000000

# ----- 6. LIMITES DE DÉBIT (défauts production) -----
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OTP_MAX=10

# ----- 7. PAIEMENT (sandbox en premier déploiement) -----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_URL=
WAVE_API_KEY=
WAVE_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=
CARD_API_KEY=
CARD_API_URL=
CARD_PROVIDER=

# ----- 8. CARTE / ROUTING GPS -----
MAP_PROVIDER=
MAP_API_KEY=
ROUTING_PROVIDER=haversine
ROUTING_API_URL=
ROUTING_API_KEY=
DEFAULT_COUNTRY=BJ
DEFAULT_LOCALE=fr

# ----- 9. SMS / OTP -----
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=CAUTO
OTP_API_URL=
OTP_API_KEY=

# ----- 10. E-MAIL -----
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=

# ----- 11. WHATSAPP -----
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE=cauto_plain

# ----- 12. PUSH / NOTIFICATIONS -----
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT=
NOTIF_FALLBACK_ORDER=push,sms,email,whatsapp

# ----- 13. IA EXTERNE (réservée à une future intégration) -----
AI_PROVIDER=
AI_API_KEY=

# ----- 14. SÉCURITÉ FICHIERS -----
# Scan antivirus optionnel (ex: clamscan). Vide = désactivé.
AV_SCAN_CMD=
DOC_MAX_BYTES=5242880

# ----- 15. SAUVEGARDES (module 64) -----
# Scripts : deploy/backup.sh (dump + validation + rotation + stockage externe)
# et deploy/restore-test.sh (restauration testée, comparée à la source).
# Une sauvegarde sans restauration réussie n'est PAS une sauvegarde.
# Chaque jour : snapshot quotidien ; le dimanche : hebdomadaire ; le 1er du
# mois : mensuel — d'où un historique conservé selon les counts ci-dessous.
BACKUP_DIR=/srv/cauto/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=6
# Réutilise les identifiants STORAGE_* de la section 4 : le dump est poussé
# sous <STORAGE_PREFIX>/backups/ (bucket S3-compatible = stockage externe).
# BACKUP_REMOTE_KEEP: objets distants conservés (défaut 30).
BACKUP_REMOTE_KEEP=30
# Webhook optionnel (ex: Discord/Slack) notifié à chaque backup :
BACKUP_NOTIFY_URL=

# ----- 16. OBSERVABILITÉ (module 65) -----
# Logs JSON structurés sur stdout (json-file Docker / Loki / Datadog…) :
LOG_LEVEL=info
# Export Prometheus (/api/ops/metrics). EN PRODUCTION obligatoire d'accompagner
# le token : sans METRICS_TOKEN l'endpoint est refusé (404) — jamais exposé nu.
METRICS_ENABLED=true
# Générer : openssl rand -hex 32, puis fournir aux collecteurs (Prometheus,
# Grafana Cloud, VictoriaMetrics…) via la config du scraper (bearer_token).
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_32
METRICS_PREFIX=cauto
SERVICE_NAME=cauto-backend
# Watchdog disponibilité : webhook notifié après ALERT_UNHEALTHY_THRESHOLD
# sondes dégradées consécutives puis à la récupération. Grafana/PagerDuty…
# ALERT_WEBHOOK_URL=