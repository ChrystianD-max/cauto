# =============================================================================
# C-AUTO — ENVIRONNEMENT PRODUCTION Serv00.com (gratuit, sans carte)
# -----------------------------------------------------------------------------
# Copier vers ../.env (racine du dépôt) : backend/src/config.js charge
# ../../.env — le fichier est exclu du contrôle de version (.gitignore).
# Ajustements Vs environnement compose : pas de Docker ici — Passenger (nginx
# de Serv00) lance directement le backend Node (démarrage "entreprise") ;
# PostgreSQL est celui fourni par Serv00 (panneau DevilWEB) ; PAS de Redis
# (le backend ne le requiert pas au démarrage — dégradation douce du worker).
# =============================================================================

# ----- 1. APPLICATION -----
NODE_ENV=production
APP_ENV=production
PORT=4000
# Domaine réel Serv00 (ex : https://votuser.serv00.net) :
APP_URL=https://CHANGE_ME.serv00.net
APP_PUBLIC_URL=https://CHANGE_ME.serv00.net
TRUST_PROXY=1
# Origine front (même domaine) — compléter si un 2e site sert le front :
CORS_ORIGINS=
# Cookies Secure auto en production ; SameSite Lax suffit (même domaine) :
COOKIE_SAME_SITE=lax

# ----- 2. BASE DE DONNÉES -----
# Option A — PostgreSQL fourni par Serv00 : créer la base via DevilWEB
# (site -> MySQL/PostgreSQL), puis renseigner le lien pg (pg<serveur>.serv00.com) :
#   DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@pg.serv00.com:5432/db
# Option B — Neon managé (choisi en 09/2026) : utiliser la connexion DIRECTE
# (pas le pooler qui refuse le paramètre de démarrage search_path) et ajouter
# options=-csearch_path%3Dpublic (impératif, le search_path Neon est vide) :
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@ep-NOM_BDD.c-4.us-east-2.aws.neon.tech:5432/neondb?sslmode=require&options=-csearch_path%3Dpublic
REDIS_URL=
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=2h

# ----- 3. MODE DÉMONSTRATION (fige paiement/SMS/GPS en simulé) -----
DEMO_MODE=false

# ----- 4. STOCKAGE OBJET (vide => disque local UPLOAD_DIR) -----
STORAGE_MODE=auto
UPLOAD_DIR=$HOME/uploads

# ----- 5. LIMITES DE DÉBIT -----
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OTP_MAX=10

# ----- 6. OBSERVABILITÉ -----
LOG_LEVEL=info
METRICS_ENABLED=true
# Générer : openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME
METRICS_PREFIX=cauto
SERVICE_NAME=cauto-backend
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=